# World Cup teams to track in the WhatsApp digest.
WORLD_CUP_TEAMS="New Zealand,England,Ivory Coast,Norway"

# 10:00 in this timezone by default. Change if "10am" should mean another locale.
WORLD_CUP_DIGEST_TIMEZONE=Pacific/Auckland
WORLD_CUP_DIGEST_HOUR=10
WORLD_CUP_DIGEST_MINUTE=0

# football-data.org v4 credentials and competition settings.
FOOTBALL_DATA_TOKEN=replace-with-football-data-token
FOOTBALL_COMPETITION_CODE=WC
FOOTBALL_SEASON=2026

# Google News RSS settings.
GOOGLE_NEWS_LOCALE=en-US
GOOGLE_NEWS_REGION=US:en

# Twilio WhatsApp settings. Numbers may include or omit the "whatsapp:" prefix.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_TO=replace-with-recipient-whatsapp-number

# Set true to print the digest instead of sending a WhatsApp message.
WORLD_CUP_AGENT_DRY_RUN=false
